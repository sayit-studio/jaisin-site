# ─────────────────────────────────────────────────────────
# 宅心驗屋 — 環境變數範本
# 複製此檔案為 .env 並填入實際值
# .env 不應提交至版本控制（已加入 .gitignore）
# ─────────────────────────────────────────────────────────

# ── Google Analytics 4 ──────────────────────────────────
# 前往 Google Analytics → 管理 → 資料串流 → 取得 Measurement ID
# 格式：G-XXXXXXXXXX
VITE_GA4_ID=G-XXXXXXXXXX

# ── 企業合作表單 Webhook ─────────────────────────────────
# n8n 或其他自動化工具的 Webhook 接收端點
# 企業合作表單送出後會 POST 至此 URL
VITE_ENTERPRISE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/enterprise

# 註：說明會報名已改為導向 LINE 官方帳號，不再有站內表單，
#     故不需要 VITE_SEMINAR_WEBHOOK_URL。

# ── LIFF 驗屋預約頁 ──────────────────────────────────────
VITE_LIFF_BOOKING_ID=1234567890-abcdefgh
VITE_BOOKING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/inspection-booking

